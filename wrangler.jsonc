{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xcity-xxxx",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
  "/watch.html",
  "/sitemap.xml"
]
  }
}